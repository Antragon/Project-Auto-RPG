[sub_resource type="Shader" id="Shader_circle_mask"]
code = "shader_type canvas_item;

varying vec2 local_position;

void vertex() {
    local_position = VERTEX;
}

void fragment() {
    float distance_from_center = distance(local_position, vec2(36.0));
    float edge_alpha = 1.0 - smoothstep(35.0, 36.0, distance_from_center);

    if (edge_alpha <= 0.0) {
        discard;
    }

    COLOR = texture(TEXTURE, UV);
    COLOR.a *= edge_alpha;
}
"

